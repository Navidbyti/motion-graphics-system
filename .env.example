# Copy to .env. Gitignored; never commit.
# Everything here is optional — the app runs fine with no .env at all.

# Only needed on networks where outbound HTTPS must go through a proxy.
# Node ignores proxy environment variables, so it has to be set here.
HTTPS_PROXY=

# Optional overrides
# MG_WATCH_FOLDER=D:\path\to\your\watch\folder
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
