# Copy to .env and fill in. .env is gitignored and must never be committed.

# Google AI Studio key. Powers prompt-to-props only.
# Without it the app still works fully — the prompt box is simply hidden.
# Restrict the key to the Generative Language API and set a quota cap.
GEMINI_API_KEY=

# Only needed where Google's APIs are geo-blocked and reached via a local proxy.
# Node's fetch ignores proxy environment variables, so it must be set here.
# Leave empty for a direct connection.
HTTPS_PROXY=

# Optional overrides
# MG_GEMINI_MODEL=gemini-flash-latest
# MG_WATCH_FOLDER=D:\path\to\your\watch\folder
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
